MEMORY_API_URL=https://your-project.supabase.co/functions/v1/memory-api
MEMORY_API_KEY=replace-with-your-memory-api-key
MEMORY_FILES_DIR=./memory
MEMORY_PRIORITY_MAP=./scripts/memory-sync/priority-map.example.json

# Prime Radiant write-back safety defaults.
# Keep live writes off until read-only, dry-run, replay, and rollback proof pass.
PRIME_RADIANT_WRITEBACK_ENABLED=0
PRIME_RADIANT_WRITEBACK_MODE=dry_run
PRIME_RADIANT_LIVE_WRITES=0
PRIME_RADIANT_ALLOWED_OPERATIONS=assign_agent_to_plan,unassign_agent_from_plan,replace_lane_assignment
PRIME_RADIANT_AUDIT_DIR=./audit/prime-radiant
PRIME_RADIANT_AGENT_ROSTER=./data/prime-radiant-agents.example.json
PRIME_RADIANT_ASSIGNMENT_LEDGER=./data/prime-radiant-assignments.example.json
