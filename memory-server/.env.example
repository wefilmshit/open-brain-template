# Required -- point at your deployed memory-api Edge Function.
MEMORY_API_URL=https://your-project.supabase.co/functions/v1/memory-api
MEMORY_API_KEY=replace-with-your-memory-api-key

# Optional -- Mem0 mirror. Leave MEM0_API_KEY unset to run without Mem0;
# every Mem0 call becomes a no-op. See docs/self-hosting-fixes.md for the
# infer:false trade-off before enabling this.
MEM0_API_KEY=
MEM0_USER_ID=default_user
MEM0_BASE_URL=https://api.mem0.ai
